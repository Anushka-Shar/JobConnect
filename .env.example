# Copy this file to .env and fill in your own values before deploying.

PORT=3000
NODE_ENV=production

# Used to sign login (JWT) tokens and session cookies. Set a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=change-this-too-a-different-long-random-string

# OPTIONAL: Add either key to upgrade the built-in AI recommendation engine's
# match explanations from rule-based text to real LLM-generated text.
# The app works perfectly without these -- they are purely an enhancement.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
