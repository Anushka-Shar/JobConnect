<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="brand">
      <span class="logo-mark">JC</span>
      <span>Job<span class="gradient-text">Connect</span></span>
    </a>

    <% if (currentUser) { %>
      <div class="nav-search">
        <input type="text" placeholder="Search jobs, skills, companies..." value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>">
      </div>

      <div class="nav-links">
        <a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
          <span class="nav-icon">🏠</span> Home
        </a>
        <a href="/jobs" class="nav-link <%= currentPath === '/jobs' ? 'active' : '' %>">
          <span class="nav-icon">💼</span> Jobs
        </a>
        <a href="/network" class="nav-link <%= currentPath === '/network' ? 'active' : '' %>">
          <span class="nav-icon">👥</span> Network
          <% if (typeof pendingConnCount !== 'undefined' && pendingConnCount > 0) { %>
            <span class="badge-dot"><%= pendingConnCount %></span>
          <% } %>
        </a>
        <a href="/companies" class="nav-link <%= currentPath === '/companies' ? 'active' : '' %>">
          <span class="nav-icon">🏢</span> Companies
        </a>
        <a href="/notifications" class="nav-link <%= currentPath === '/notifications' ? 'active' : '' %>">
          <span class="nav-icon">🔔</span> Alerts
          <% if (typeof unreadNotifCount !== 'undefined' && unreadNotifCount > 0) { %>
            <span class="badge-dot"><%= unreadNotifCount %></span>
          <% } %>
        </a>
        <a href="/profile/<%= currentUser.id %>" class="nav-link <%= currentPath && currentPath.startsWith('/profile') ? 'active' : '' %>">
          <% if (currentUser.avatar) { %>
            <img src="<%= currentUser.avatar %>" class="avatar-sm" alt="">
          <% } else { %>
            <span class="nav-icon">👤</span>
          <% } %>
          Me
        </a>
        <a href="/logout" class="nav-link">
          <span class="nav-icon">🚪</span> Logout
        </a>
      </div>
    <% } else { %>
      <div class="nav-links">
        <a href="/jobs" class="nav-link">Browse Jobs</a>
        <a href="/login" class="btn btn-ghost btn-sm">Log in</a>
        <a href="/register" class="btn btn-primary btn-sm">Join now</a>
      </div>
    <% } %>
  </div>
</nav>

<div class="flash-wrap">
  <% if (messages.success && messages.success.length) { %>
    <% messages.success.forEach(m => { %><div class="flash flash-success">✅ <%= m %></div><% }) %>
  <% } %>
  <% if (messages.error && messages.error.length) { %>
    <% messages.error.forEach(m => { %><div class="flash flash-error">⚠️ <%= m %></div><% }) %>
  <% } %>
</div>
