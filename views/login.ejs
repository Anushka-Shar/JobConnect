<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-logo">Welcome <span class="gradient-text">back</span></div>
    <form method="POST" action="/login">
      <label>Email</label>
      <input type="email" name="email" placeholder="you@example.com" required autofocus>
      <label>Password</label>
      <input type="password" name="password" placeholder="Your password" required>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:22px;">Log in</button>
    </form>
    <div class="auth-switch">New to JobConnect? <a href="/register" class="gradient-text" style="font-weight:600;">Create an account</a></div>
  </div>
</div>

<%- include('partials/footer') %>
