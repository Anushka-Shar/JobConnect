<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="page-wrap container">
  <div class="grid-2">
    <div>
      <% if (pending.length) { %>
      <div class="card">
        <h2 class="card-title">Pending invitations</h2>
        <% pending.forEach(p => { %>
          <div style="display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid var(--border);">
            <% if (p.avatar) { %><img src="<%= p.avatar %>" class="avatar-md" alt="">
            <% } else { %><div class="avatar-md avatar-placeholder"><%= p.name.charAt(0) %></div><% } %>
            <div style="flex:1;">
              <div style="font-weight:600;"><%= p.name %></div>
              <div style="color:var(--muted); font-size:0.8rem;"><%= p.headline || '' %></div>
            </div>
            <form method="POST" action="/network/respond/<%= p.id %>" style="display:flex; gap:6px;">
              <button name="action" value="accept" class="btn btn-primary btn-sm">Accept</button>
              <button name="action" value="decline" class="btn btn-ghost btn-sm">Decline</button>
            </form>
          </div>
        <% }) %>
      </div>
      <% } %>

      <div class="card">
        <div class="section-title"><h2>✨ People you may know</h2></div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:14px;">
          <% suggestions.forEach(p => { %>
            <div class="card person-card">
              <% if (p.avatar) { %><img src="<%= p.avatar %>" class="avatar-md" alt="">
              <% } else { %><div class="avatar-md avatar-placeholder" style="margin:0 auto 10px;"><%= p.name.charAt(0) %></div><% } %>
              <div class="person-name"><a href="/profile/<%= p.id %>"><%= p.name %></a></div>
              <div class="person-headline"><%= p.headline || '' %></div>
              <% if (p.sameCompany) { %><span class="tag" style="margin-bottom:8px;">Same company</span><% } %>
              <form method="POST" action="/network/connect/<%= p.id %>">
                <button class="btn btn-outline btn-sm btn-block" type="submit">+ Connect</button>
              </form>
            </div>
          <% }) %>
        </div>
        <% if (!suggestions.length) { %><div class="form-hint">No new suggestions right now — check back soon.</div><% } %>
      </div>
    </div>

    <div>
      <div class="card">
        <h4 style="margin:0 0 10px;">My connections (<%= myConnections.length %>)</h4>
        <% myConnections.forEach(c => { %>
          <div style="display:flex; align-items:center; gap:10px; padding:8px 0;">
            <% if (c.avatar) { %><img src="<%= c.avatar %>" class="avatar-sm" alt="">
            <% } else { %><div class="avatar-sm avatar-placeholder" style="font-size:0.7rem;"><%= c.name.charAt(0) %></div><% } %>
            <div>
              <a href="/profile/<%= c.id %>" style="font-size:0.85rem; font-weight:600;"><%= c.name %></a>
              <div style="color:var(--muted); font-size:0.72rem;"><%= c.headline || '' %></div>
            </div>
          </div>
        <% }) %>
        <% if (!myConnections.length) { %><div class="form-hint">No connections yet.</div><% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
