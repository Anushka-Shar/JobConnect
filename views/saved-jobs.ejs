<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="page-wrap container" style="max-width:800px;">
  <div class="section-title"><h2>Saved Jobs</h2></div>
  <% if (!jobs.length) { %>
    <div class="card empty-state"><div class="big-icon">🔖</div>No saved jobs yet.</div>
  <% } %>
  <% jobs.forEach(job => { %>
    <%- include('partials/job-card', { job }) %>
  <% }) %>
</div>

<%- include('partials/footer') %>
