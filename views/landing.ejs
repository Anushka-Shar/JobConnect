<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="hero">
  <h1>Find the job that <span class="gradient-text">finds you back</span>.</h1>
  <p>JobConnect matches you to roles, companies, and people using an AI-powered recommendation engine — built for how careers actually move.</p>
  <div class="hero-actions">
    <a href="/register" class="btn btn-primary">Get started — it's free</a>
    <a href="/jobs" class="btn btn-outline">Browse open jobs</a>
  </div>
  <div class="hero-stats">
    <div class="hero-stat"><div class="num">12K+</div><div class="lbl">Open roles</div></div>
    <div class="hero-stat"><div class="num">3.4K+</div><div class="lbl">Companies</div></div>
    <div class="hero-stat"><div class="num">98%</div><div class="lbl">Match accuracy*</div></div>
  </div>
</div>

<div class="feature-grid">
  <div class="card feature-card">
    <div class="feature-icon">🤖</div>
    <h3>AI Job Matching</h3>
    <p style="color:var(--muted); font-size:0.9rem;">Our recommendation engine scores every open role against your skills, experience, and location in real time.</p>
  </div>
  <div class="card feature-card">
    <div class="feature-icon">🏢</div>
    <h3>Smart Company Suggestions</h3>
    <p style="color:var(--muted); font-size:0.9rem;">Discover companies actively hiring for roles that fit your profile — before you even search.</p>
  </div>
  <div class="card feature-card">
    <div class="feature-icon">🔔</div>
    <h3>Eligible Job Alerts</h3>
    <p style="color:var(--muted); font-size:0.9rem;">Get notified automatically the moment a strong-match job is posted — no need to keep refreshing.</p>
  </div>
  <div class="card feature-card">
    <div class="feature-icon">🤝</div>
    <h3>People You May Know</h3>
    <p style="color:var(--muted); font-size:0.9rem;">Build your network with suggestions based on shared skills, companies, and education.</p>
  </div>
  <div class="card feature-card">
    <div class="feature-icon">📄</div>
    <h3>One-Click Apply</h3>
    <p style="color:var(--muted); font-size:0.9rem;">Upload your resume once, apply everywhere, and track every application status in one place.</p>
  </div>
  <div class="card feature-card">
    <div class="feature-icon">📊</div>
    <h3>Recruiter Dashboard</h3>
    <p style="color:var(--muted); font-size:0.9rem;">Post jobs and instantly see AI-ranked applicants sorted by best fit.</p>
  </div>
</div>

<%- include('partials/footer') %>
